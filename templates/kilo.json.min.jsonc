{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".memory/project_brief.md",
    ".memory/active_context.md",
    ".memory/progress.md"
  ],
  "snapshot": false,
  "skills": {
    "paths": [".kilo/skills"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "rm *": "ask",
      "del *": "ask",
      "Remove-Item*": "ask",
      "sed -i*": "ask"
    },
    "read": {
      ".env*": "deny",
      "**/.env*": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "question": "allow",
    "task": {
      "*": "deny",
      "general": "allow",
      "explore": "allow",
      "reviewer": "allow",
      "cheap-worker": "allow"
    },
    "edit": {
      ".env*": "deny",
      "**/.env*": "ask",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "node_modules/**": "deny",
      "**/node_modules/**": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "AGENTS.md": "allow",
      "kilo.json": "allow",
      ".kilo/**": "allow",
      ".memory/**": "allow",
      ".run/**": "allow",
      "docs/**": "allow",
      "scripts/**": "allow",
      "tests/**": "allow",
      "*": "ask"
    }
  }
}
